<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(GameVersion)' == '1.6'">net472</TargetFramework>
    <TargetFramework Condition="'$(GameVersion)' == '1.7'">net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SearchlightLightingHarness</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ManagedDir>$(RimWorldDir)/RimWorldWin64_Data/Managed</ManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="LightingHarness.cs" />
    <Reference Include="../../$(GameVersion)/Assemblies/DirectedSearchlights.dll" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(GameVersion)' == '1.6'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="$(ManagedDir)/Assembly-CSharp.dll;$(ManagedDir)/UnityEngine.CoreModule.dll" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(GameVersion)' == '1.7'">
    <Reference Include="$(RimWorldDir)/Assembly-CSharp.dll;$(RimWorldDir)/UnityStubs.dll;$(RimWorldDir)/Waylith.UnityCompat.dll;$(RimWorldDir)/Waylith.dll" Private="false" />
  </ItemGroup>
</Project>
