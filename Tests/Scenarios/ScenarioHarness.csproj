<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$(MSBuildProjectDirectory)/../../../..</RimWorldDir>
    <GameVersion Condition="'$(GameVersion)' == '' And Exists('$(RimWorldDir)/RimWorld.exe') And Exists('$(RimWorldDir)/Assembly-CSharp.dll')">1.7</GameVersion>
    <GameVersion Condition="'$(GameVersion)' == ''">1.6</GameVersion>
    <TargetFramework Condition="'$(GameVersion)' == '1.6'">net472</TargetFramework>
    <TargetFramework Condition="'$(GameVersion)' == '1.7'">net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>SearchlightScenarioHarness</AssemblyName>
    <OutputPath>HarnessMod/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>latest</LangVersion>
    <ManagedDir>$(RimWorldDir)/RimWorldWin64_Data/Managed</ManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ScenarioHarness.cs;TrackingScenario.cs;SweepApiScenario.cs;EnemyStandbyScenario.cs;NightOnlyScenario.cs;SolarScenario.cs" />
    <Reference Include="../../$(GameVersion)/Assemblies/DirectedSearchlights.dll" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(GameVersion)' == '1.6'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="$(ManagedDir)/Assembly-CSharp.dll;$(ManagedDir)/UnityEngine.CoreModule.dll;$(ManagedDir)/UnityEngine.IMGUIModule.dll;$(ManagedDir)/UnityEngine.dll" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(GameVersion)' == '1.7'">
    <Reference Include="$(RimWorldDir)/Assembly-CSharp.dll;$(RimWorldDir)/UnityStubs.dll;$(RimWorldDir)/Waylith.UnityCompat.dll;$(RimWorldDir)/Waylith.dll" Private="false" />
  </ItemGroup>
</Project>
